# Optional local overrides (copy to config.local.env and customize)

DB_PROD_CONNECTION_STRING=Server=127.0.0.1;Database=YourProdDb;User Id=readonly_user;Password=your_password;TrustServerCertificate=True;
DB_PROD_MAX_ROWS=200
DB_PROD_QUERY_TIMEOUT_MS=9000
DB_PROD_MAX_RESULT_BYTES=5242880
DB_PROD_TEXTSIZE_BYTES=262144
DB_PROD_MAX_ROW_BYTES=262144

ANON_MODEL_PROVIDER=ollama
ANON_MODE=hybrid
ANON_FIELD_IDENTIFICATION=hybrid
ANON_HASH_SALT=change-me-stable-secret
ANON_MODEL_BASE_URL=http://127.0.0.1:11434
ANON_MODEL_NAME=qwen2.5:3b-instruct
ANON_FAIL_OPEN=false
ANON_TIMEOUT_MS=5000
ANON_LLM_MAX_ROWS=2
ANON_LLM_MAX_CELLS=40
ANON_LLM_MAX_INPUT_CHARS=3000

MCP_PROD_HOST=127.0.0.1
MCP_PROD_PORT=8782
MCP_PROD_PATH=/sse

MCP_MODELS_DIR=.local/models
OLLAMA_MODELS=.local/models/ollama
